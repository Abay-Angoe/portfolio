# Copy to .env.local and fill in.

# Deployed origin — used for absolute Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# Optional: enables real Creative-Commons music in the Music app (via Jamendo).
# Get a free client id at https://devportal.jamendo.com. When unset, the Music
# app falls back to built-in browser-synthesized tunes.
NEXT_PUBLIC_JAMENDO_CLIENT_ID=

# Optional: enables real form submissions from the Mail app (via Formspree).
# Create a form at https://formspree.io and use its id (the part after /f/).
# When unset, Mail opens the visitor's own mail client with a prefilled message.
NEXT_PUBLIC_FORMSPREE_ID=
